<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:layout_margin="6dp"
    android:orientation="vertical"
    android:background="@drawable/bg_vital_panel"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/bigVitalIcon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:tint="@color/accent"
            android:contentDescription="@null"
            tools:src="@drawable/ic_heart" />

        <TextView
            android:id="@+id/bigVitalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textSize="12sp"
            android:textColor="@color/text_dim"
            tools:text="SpO2" />
    </LinearLayout>

    <TextView
        android:id="@+id/bigVitalValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        tools:text="98%" />

    <TextView
        android:id="@+id/bigVitalSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:textColor="@color/text_dim"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="còn khoảng 34 phút" />

</LinearLayout>
