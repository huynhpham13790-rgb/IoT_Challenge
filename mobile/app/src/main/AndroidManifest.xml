<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartIVMonitor"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">
        <!-- The hospital's HisServer instance is plain HTTP on the ward LAN
             (see server/README.md - it runs behind no reverse proxy by
             default), not a public HTTPS endpoint, and its address is
             whatever IP a nurse types on the login screen. There is no
             fixed domain to scope a network security config to, so
             cleartext is allowed app-wide; this app never talks to the
             open internet regardless. -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartIVMonitor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartIVMonitor"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
